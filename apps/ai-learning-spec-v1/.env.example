# Database (required) — PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL=

# AI provider (optional). If none is set, the AI Mentor returns a truthful
# "provider unavailable" state and a rule-based study protocol. It never
# fabricates a model response.
PUTER_AUTH_TOKEN=
PUTER_MODEL_NAME=
PUTER_FAST_MODEL_NAME=
PUTER_API_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional integrations (not required to run the application).
SEARCH_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
