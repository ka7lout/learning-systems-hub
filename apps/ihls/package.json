{
  "name": "@lsh/ihls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "validate:content": "tsx --tsconfig tsconfig.scripts.json scripts/validate-content.ts",
    "test": "vitest run",
    "smoke": "tsx --tsconfig tsconfig.scripts.json scripts/smoke.ts",
    "verify": "npm run typecheck && npm run lint && npm run validate:content && npm run test",
    "export:research": "tsx --tsconfig tsconfig.scripts.json scripts/export-research.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "lucide-react": "0.544.0",
    "mongodb": "6.20.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
